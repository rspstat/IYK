# 이 파일을 복사해서 같은 폴더(code/backend)에 `.env` 로 만들고 값을 채운다. `.env` 는 .gitignore 대상이라 커밋되지 않는다.
# 등호(=) 앞뒤에 공백을 넣지 말고, 따옴표 없이 키를 그대로 붙여넣는다.
# 공공데이터포털 마이페이지 > 개발계정에서 확인한 일반 인증키. Encoding 키와 Decoding 키 중 아무거나 넣어도 된다.

# (A) 9개 API가 모두 같은 키를 쓰면 이 한 줄만 채우면 된다.
TOURAPI_SERVICE_KEY=

# (B) API마다 키가 다르면 아래를 각각 채운다. 값이 있는 API는 개별 키를, 비어 있으면 (A)의 공용 키를 쓴다.
TOURAPI_KEY_KOR=
TOURAPI_KEY_RELATED=
TOURAPI_KEY_PHOTO=
TOURAPI_KEY_CONGESTION=
TOURAPI_KEY_PET=
TOURAPI_KEY_BARRIER_FREE=
TOURAPI_KEY_WELLNESS=
TOURAPI_KEY_CAMPING=
TOURAPI_KEY_DURUNUBI=
#   KOR          국문 관광정보 서비스
#   RELATED      관광지별 연관 관광지 정보
#   PHOTO        관광사진 정보
#   CONGESTION   관광지 집중률 방문자 추이 예측 정보
#   PET          반려동물 동반여행 서비스
#   BARRIER_FREE 무장애 여행 정보
#   WELLNESS     웰니스관광정보
#   CAMPING      고캠핑 정보 조회서비스
#   DURUNUBI     두루누비 정보 서비스

# 카카오 로그인(선택). 비워두면 로그인 화면의 "카카오로 계속하기" 버튼이 숨겨지고 이메일 로그인만 쓴다.
# Kakao Developers 앱에서: (1) [카카오 로그인] > 사용 설정 ON, (2) [앱] > [플랫폼 키] > REST API 키를 열어
# 리다이렉트 URI 에 http://localhost:5173/auth/kakao/callback 등록(배포하면 배포 주소도), (3) 같은 화면의 클라이언트 시크릿과 REST API 키를 아래에 복사.
# REST API 키는 JavaScript 키(지도·공유용)와 다른 키다. 클라이언트 시크릿은 서버에서만 쓰며 절대 프론트나 커밋에 넣지 않는다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 배포 환경에서는 운영용 값으로 반드시 교체한다 (미지정 시 application.yml 의 개발용 기본값 사용).
# JWT_SECRET=
