# 이 파일을 복사해서 같은 폴더(code/backend)에 `.env` 로 만들고 값을 채운다. `.env` 는 .gitignore 대상이라 커밋되지 않는다.
# 등호(=) 앞뒤에 공백을 넣지 말고, 따옴표 없이 키를 그대로 붙여넣는다.

# 공공데이터포털 마이페이지 > 개발계정 > 일반 인증키. Encoding 키와 Decoding 키 중 아무거나 넣어도 된다.
TOURAPI_SERVICE_KEY=

# 배포 환경에서는 운영용 값으로 반드시 교체한다 (미지정 시 application.yml 의 개발용 기본값 사용).
# JWT_SECRET=
